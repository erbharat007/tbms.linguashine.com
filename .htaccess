# ===================================================================
# TBMS Linguashine - Root .htaccess (Localhost / WAMP Environment)
# Redirects all incoming traffic to the public/ directory securely
# Last Updated: 2026-10-21
# ===================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory listing
    Options -Indexes

    # Pass Authorization Header to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Prevent direct access to sensitive configuration, version control, and lock files
    <FilesMatch "^\.(env|git|editorconfig|gitattributes|gitignore)">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    <FilesMatch "(composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|artisan)">
        <IfModule mod_authz_core.c>
            Require all denied
        </IfModule>
        <IfModule !mod_authz_core.c>
            Order allow,deny
            Deny from all
        </IfModule>
    </FilesMatch>

    # Block direct web access to internal application directories
    RewriteRule ^(app|bootstrap/cache|config|database|resources|routes|storage|tests|unused_files)/ - [F,L,NC]

    # Rewrite all traffic into the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
